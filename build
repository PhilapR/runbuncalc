#!/usr/bin/env node
'use strict';

const path = require('path');
const fs = require('fs');
const crypto = require('crypto');

const rootDir = '.';

// update version
function makeCachebuster(template, output) {
	let indexContents = fs.readFileSync(path.resolve(rootDir, template), {encoding: 'utf8'});

	// add hashes to js and css files
	process.stdout.write("Updating hashes... ");
	indexContents = indexContents.replace(/(src|href)="\.\/(.*?)\?[a-z0-9]*?"/g, function (a, b, c) {
		let hash = Math.random(); // just in case creating the hash fails
		try {
			const filename = c.replace('//play.pokemonshowdown.com/', '../../play.pokemonshowdown.com/');
			const fstr = fs.readFileSync(path.resolve(rootDir, 'dist', filename), 'utf8');
			hash = crypto.createHash('md5').update(fstr).digest('hex').substr(0, 8);
		} catch (e) {}

		return b + '="./' + c + '?' + hash + '"';
	}).replace(/\.template\.html/g, '.html');
	process.stdout.write("Writing new `" + output + "` file... ");
	fs.writeFileSync(path.resolve(rootDir, output), indexContents);
	console.log("DONE");
}

// Adapt TypeScript CommonJS emit for the calculator UI's classic <script>
// loader. That loader shares one global `exports` object and stubs
// `require()` to return it, so modules are not truly isolated.
function prepareBrowserCalcModule(contents, {isCalcRootIndex = false} = {}) {
	contents = contents.replace(/^exports.* = void 0;$/gm, '');

	// Re-export getters become infinite loops when `mod === exports`
	// (`get() { return calc_1.calculate }` reads the getter itself).
	contents = contents.replace(
		/Object\.defineProperty\(exports, "([^"]+)", \{ enumerable: true, get: function \(\) \{ return (\w+)\.\1; \} \}\);/g,
		'exports.$1 = $2.$1;'
	);

	// `export function calculate` emits `exports.calculate = calculate` before
	// the adaptable import snapshot. Defer those assignments until after
	// `Acalculate` is captured so the wrapper does not call itself.
	if (isCalcRootIndex) {
		contents = contents
			.replace(/^exports\.calculate = calculate;\r?\n/m, '')
			.replace(/^exports\.calcStat = calcStat;\r?\n/m, '');
		if (/const Acalculate = A\.calculate;/.test(contents)) {
			contents = contents.replace(
				/(const Acalculate = A\.calculate;\r?\n)/,
				'$1exports.calculate = calculate;\nexports.calcStat = calcStat;\n'
			);
		}
	}

	return '(function () {\n' + contents + '\n})();\n';
}

function cpdir(src, dest, options = {}) {
	console.log("Copying `" + src + "` to `" + dest + "`");
	try {
		fs.mkdirSync(dest, '0755');
	} catch(e) {
		if (e.code != 'EEXIST') throw e;
	}
	for (const file of fs.readdirSync(src)) {
		var current = fs.lstatSync(path.join(src, file));
		if (current.isDirectory()) {
			cpdir(path.join(src, file), path.join(dest, file), options);
		} else if (current.isSymbolicLink()) {
			var symlink = fs.readlinkSync(path.join(src, file));
			fs.symlinkSync(symlink, path.join(dest, file));
		} else if (file.endsWith('.js')) {
			let contents = fs.readFileSync(path.join(src, file), 'utf8');
			const srcPath = src.replace(/\\/g, '/');
			const wrapCommonJs = options.wrapCommonJs &&
				!file.endsWith('.min.js') &&
				!srcPath.includes('/test');
			if (wrapCommonJs) {
				const isCalcRootIndex = file === 'index.js' && /(?:^|\/)calc\/dist$/.test(srcPath);
				contents = prepareBrowserCalcModule(contents, {isCalcRootIndex});
			} else {
				contents = contents.replace(/^exports.* = void 0;$/gm, '');
			}
			fs.writeFileSync(path.join(dest, file), contents);
		} else {
			fs.copyFileSync(path.join(src, file),path.join(dest, file));
		}
	}
}

if (process.argv[2] !== 'view') {
	require('child_process').execSync('npm --prefix calc/ run compile', {stdio: 'inherit'});
}

cpdir('src', 'dist');
cpdir('calc/dist', 'dist/calc', {wrapCommonJs: true});
makeCachebuster('dist/honkalculate.template.html', 'dist/honkalculate.html');
makeCachebuster('dist/index.template.html', 'dist/index.html');
